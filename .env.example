NEXTAUTH_URL=http://localhost:3999
NEXTAUTH_SECRET=replace-with-openssl-rand
# Optional fallback used by newer Auth.js naming; app prefers NEXTAUTH_SECRET first.
AUTH_SECRET=replace-with-openssl-rand

# MySQL connection string (e.g., host:port/db_name)
DATABASE_URL=<your-database-url-here>
# Shadow database for Prisma migrations
SHADOW_DATABASE_URL=<your-shadow-database-url-here>

# Internal MinIO endpoint used by server-side storage operations.
S3_ENDPOINT=http://localhost:9000
# Production example: expose the uploads bucket through your app domain.
# S3_INTERNAL_ENDPOINT=http://127.0.0.1:9000
# S3_PUBLIC_ENDPOINT=https://storgbay.online
S3_REGION=us-east-1
S3_ACCESS_KEY=root
S3_SECRET_KEY=changeme
S3_BUCKET=uploads
S3_FORCE_PATH_STYLE=true
# Optional: enable server-side encryption (e.g., AES256 for MinIO).
# S3_SSE_ALGORITHM=AES256

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=changeme

# Bearer token used to authenticate cron job requests (e.g., data retention cleanup).
CRON_SECRET=replace-with-random-secret
